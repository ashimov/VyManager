# ==============================================================================
# Root docker-compose configuration (postgres + redis)
# Copy to .env (gitignored) and fill in real values before `docker compose up`.
# ==============================================================================

# PostgreSQL credentials. Generate a strong password: openssl rand -base64 32
POSTGRES_USER=vymanager
POSTGRES_PASSWORD=
POSTGRES_DB=vymanager_auth

# Optional: require a Redis password (recommended). Generate: openssl rand -base64 32
# Must match REDIS_URL in backend/.env (redis://:<password>@localhost:6379/0)
REDIS_PASSWORD=
